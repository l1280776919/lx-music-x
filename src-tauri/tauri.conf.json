{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "lx-music-x",
  "version": "0.1.8",
  "identifier": "cn.toside.music.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LX Music X",
        "width": 1040,
        "height": 680,
        "minWidth": 800,
        "minHeight": 560,
        "decorations": false,
        "center": true,
        "shadow": true
      },
      {
        "label": "lyric",
        "title": "LX Music X 桌面歌词",
        "url": "/desktop-lyric",
        "width": 760,
        "height": 120,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "resizable": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
